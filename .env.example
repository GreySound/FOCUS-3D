# ─────────────────────────────────────────────
# Copia este archivo como .env.local y rellena los valores.
# NUNCA pongas credenciales reales en este archivo (.env.example se versiona en git).
# ─────────────────────────────────────────────

# URL base de tu proyecto Supabase (sin /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (anon). Se expone en el navegador: solo debe permitir
# lo que las políticas RLS autoricen (lectura de productos, envío de mensajes).
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave service_role — SOLO servidor. Ignora RLS: NUNCA exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Contraseña del panel admin
ADMIN_PASSWORD=define-una-contraseña-fuerte

# Secreto para firmar la sesión del admin (string largo y aleatorio).
# Genera uno con: openssl rand -hex 32
SESSION_SECRET=cadena-larga-y-aleatoria

# ─────────────────────────────────────────────
# Datos públicos del negocio (opcionales). Si no los defines, se usan los
# valores por defecto de lib/site-config.ts. Todos empiezan con NEXT_PUBLIC_
# porque se inyectan también en el navegador.
# ─────────────────────────────────────────────

# WhatsApp en formato internacional, SOLO dígitos (52 + 10 dígitos).
NEXT_PUBLIC_WHATSAPP_NUMBER=526671923604

# Instagram del negocio (cuenta nueva)
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/tu-cuenta

# Tienda oficial en Mercado Libre
NEXT_PUBLIC_MERCADOLIBRE_URL=https://www.mercadolibre.com.mx

# Link de cobro/perfil de Mercado Pago (ej. https://mpago.la/xxxx)
NEXT_PUBLIC_MERCADOPAGO_URL=https://www.mercadopago.com.mx

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=https://focus3d.art

# ─────────────────────────────────────────────
# WhatsApp Cloud API (difusión de promociones a suscriptores).
# SECRETAS: NO llevan NEXT_PUBLIC_, solo viven en el servidor.
# Se obtienen en el panel de WhatsApp de tu app de Meta for Developers.
# ─────────────────────────────────────────────

# Token de acceso de la app de Meta
WHATSAPP_ACCESS_TOKEN=
# ID del número emisor (Phone Number ID)
WHATSAPP_PHONE_NUMBER_ID=
# (opcional) versión de la Graph API
WHATSAPP_API_VERSION=v22.0
# (opcional) nombre de la plantilla aprobada para promociones
WHATSAPP_PROMO_TEMPLATE=promo_focus3d
# (opcional) idioma de la plantilla de promociones
WHATSAPP_TEMPLATE_LANG=es_MX
# (opcional) nombre de la plantilla del cupón de bienvenida
WHATSAPP_CUPON_TEMPLATE=disbursement_voucher_1
# (opcional) idioma de la plantilla del cupón de bienvenida
WHATSAPP_CUPON_LANG=es
